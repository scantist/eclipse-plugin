<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension
         point="org.eclipse.ui.commands">
      <command
            defaultHandler="org.example.sca.plugin.handlers.ScaScanHandler"
            id="org.example.sca.plugin.commands.scaScan"
            name="SCA Scan">
      </command>
   </extension>
   
   <extension
         point="org.eclipse.ui.handlers">
      <handler
            class="org.example.sca.plugin.handlers.ScaScanHandler"
            commandId="org.example.sca.plugin.commands.scaScan">
      </handler>
   </extension>
   
   <extension
         point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="menu:org.eclipse.ui.main.menu?after=additions">
         <menu
               id="org.example.sca.plugin.menus.scaMenu"
               label="SCA"
               mnemonic="S">
            <command
                  commandId="org.example.sca.plugin.commands.scaScan"
                  icon="icons/scan.png"
                  label="SCA Scan"
                  style="push"
                  tooltip="Run SCA scan on the current project">
            </command>
         </menu>
      </menuContribution>
   </extension>
   
   <extension
         point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="toolbar:org.eclipse.ui.main.toolbar?after=additions">
         <toolbar
               id="org.example.sca.plugin.toolbars.scaToolbar"
               label="SCA Toolbar">
            <command
                  commandId="org.example.sca.plugin.commands.scaScan"
                  icon="icons/scan.png"
                  label="SCA Scan"
                  style="push"
                  tooltip="Run SCA scan on the current project">
            </command>
         </toolbar>
      </menuContribution>
   </extension>
   
   <extension
         point="org.eclipse.ui.preferencePages">
      <page
            id="org.example.sca.plugin.preferences.SCAPreferencePage"
            name="SCA Settings"
            class="org.example.sca.plugin.preferences.SCAPreferencePage">
      </page>
   </extension>
   
   <extension
         point="org.eclipse.core.runtime.preferences">
      <initializer
            class="org.example.sca.plugin.preferences.SCAPreferences">
      </initializer>
   </extension>
</plugin>
