Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: SCA Eclipse Plugin
Bundle-SymbolicName: org.example.sca.plugin;singleton:=true
Bundle-Version: 0.0.9.qualifier
Bundle-Activator: org.example.sca.plugin.Activator
